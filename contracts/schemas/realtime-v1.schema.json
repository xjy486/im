{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jitong.invalid/contracts/realtime-v1.schema.json",
  "title": "Jitong realtime protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/syncReadyEnvelope"
    },
    {
      "$ref": "#/$defs/messageSendEnvelope"
    },
    {
      "$ref": "#/$defs/messageEnvelope"
    },
    {
      "$ref": "#/$defs/conversationReadEnvelope"
    },
    {
      "$ref": "#/$defs/userProfileEnvelope"
    },
    {
      "$ref": "#/$defs/groupProfileEnvelope"
    },
    {
      "$ref": "#/$defs/membershipEnvelope"
    },
    {
      "$ref": "#/$defs/aiJobEnvelope"
    },
    {
      "$ref": "#/$defs/aiDeletionEnvelope"
    },
    {
      "$ref": "#/$defs/errorEnvelope"
    }
  ],
  "$defs": {
    "baseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "operation", "requestId", "body"],
      "properties": {
        "version": {
          "const": 1
        },
        "operation": {
          "type": "string"
        },
        "requestId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "body": {
          "type": "object"
        }
      }
    },
    "syncReadyEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "sync.ready"
            },
            "body": {
              "$ref": "#/$defs/syncReadyBody"
            }
          }
        }
      ]
    },
    "messageEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "enum": ["message.ack", "message.created", "message.recalled", "message.moderated"]
            },
            "body": {
              "$ref": "#/$defs/messageBody"
            }
          }
        }
      ]
    },
    "messageSendEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "message.send"
            },
            "body": {
              "$ref": "#/$defs/messageSendBody"
            }
          }
        }
      ]
    },
    "errorEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "error"
            },
            "body": {
              "$ref": "#/$defs/errorBody"
            }
          }
        }
      ]
    },
    "conversationReadEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "conversation.read"
            },
            "body": {
              "$ref": "#/$defs/conversationReadBody"
            }
          }
        }
      ]
    },
    "userProfileEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "user.profile.updated"
            },
            "body": {
              "$ref": "#/$defs/userProfileBody"
            }
          }
        }
      ]
    },
    "groupProfileEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "group.profile.updated"
            },
            "body": {
              "$ref": "#/$defs/groupProfileBody"
            }
          }
        }
      ]
    },
    "membershipEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "enum": ["membership.revoked", "membership.granted", "group.dissolved"]
            },
            "body": {
              "$ref": "#/$defs/membershipBody"
            }
          }
        }
      ]
    },
    "aiJobEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "ai.job.updated"
            },
            "body": {
              "$ref": "#/$defs/aiJobBody"
            }
          }
        }
      ]
    },
    "aiDeletionEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "enum": [
                "ai.artifact.deleted",
                "ai.job.deleted",
                "ai.action-item.updated",
                "ai.action-item.deleted"
              ]
            },
            "body": {
              "$ref": "#/$defs/aiDeletionBody"
            }
          }
        }
      ]
    },
    "syncReadyBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "deviceClass", "highWatermark"],
      "properties": {
        "deviceId": {
          "type": "string",
          "format": "uuid"
        },
        "deviceClass": {
          "type": "string",
          "enum": ["MOBILE", "PC"]
        },
        "highWatermark": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "messageBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "conversationId",
        "senderId",
        "clientMsgId",
        "conversationSeq",
        "type",
        "state",
        "text",
        "mediaId",
        "serverAcceptedAt",
        "recalledAt"
      ],
      "properties": {
        "messageId": {
          "type": "string",
          "format": "uuid"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "senderId": {
          "type": "string",
          "format": "uuid"
        },
        "clientMsgId": {
          "type": "string",
          "format": "uuid"
        },
        "conversationSeq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": ["TEXT", "IMAGE", "SYSTEM"]
        },
        "state": {
          "enum": ["ACTIVE", "RECALLED", "MODERATED"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "mediaId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "serverAcceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "recalledAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "systemEventType": {
          "type": ["string", "null"]
        },
        "systemTargetUserId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "systemRole": {
          "type": ["string", "null"]
        },
        "moderatedByUserId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "moderatedReason": {
          "type": ["string", "null"]
        },
        "moderatedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "syncSeq": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "messageSendBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "clientMsgId", "type"],
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "clientMsgId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "enum": ["TEXT", "IMAGE"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "mediaId": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "TEXT" }
            }
          },
          "then": {
            "required": ["text"]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "IMAGE" }
            }
          },
          "then": {
            "required": ["mediaId"]
          }
        }
      ]
    },
    "conversationReadBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "userId", "readSeq", "syncSeq"],
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "readSeq": {
          "type": "integer",
          "minimum": 0
        },
        "syncSeq": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "userProfileBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "displayName", "avatarUrl", "avatarVersion", "avatarFallback", "syncSeq"],
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "displayName": { "type": "string", "minLength": 1 },
        "avatarUrl": { "type": ["string", "null"] },
        "avatarVersion": { "type": "integer", "minimum": 0 },
        "avatarFallback": { "type": "string", "minLength": 1, "maxLength": 2 },
        "syncSeq": { "type": "integer", "minimum": 1 }
      }
    },
    "groupProfileBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "avatarUrl", "avatarVersion", "syncSeq"],
      "properties": {
        "conversationId": { "type": "string", "format": "uuid" },
        "avatarUrl": { "type": ["string", "null"] },
        "avatarVersion": { "type": "integer", "minimum": 0 },
        "syncSeq": { "type": "integer", "minimum": 1 }
      }
    },
    "membershipBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "syncSeq"],
      "properties": {
        "conversationId": { "type": "string", "format": "uuid" },
        "syncSeq": { "type": "integer", "minimum": 1 }
      }
    },
    "aiJobBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "conversationId",
        "kind",
        "status",
        "errorCode",
        "result",
        "syncSeq"
      ],
      "properties": {
        "jobId": { "type": "string", "format": "uuid" },
        "conversationId": { "type": "string", "format": "uuid" },
        "kind": { "type": "string", "enum": ["SUMMARY", "SMART_REPLY", "EXTRACTION"] },
        "status": { "type": "string", "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "EXPIRED"] },
        "errorCode": { "type": ["string", "null"] },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["overview", "keyPoints", "decisions", "openQuestions", "sourceMessageIds"],
              "properties": {
                "overview": { "type": "string", "minLength": 1, "maxLength": 4000 },
                "keyPoints": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1 } },
                "decisions": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1 } },
                "openQuestions": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1 } },
                "sourceMessageIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["replies"],
              "properties": {
                "replies": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text", "tone"],
                    "properties": {
                      "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
                      "tone": { "type": "string", "minLength": 1, "maxLength": 40 }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionItems", "keyFacts"],
              "properties": {
                "actionItems": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "details", "assigneeUserId", "dueAt", "priority", "confidence", "sourceMessageIds"],
                    "properties": {
                      "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                      "details": { "type": "string", "maxLength": 4000 },
                      "assigneeUserId": { "type": ["string", "null"], "format": "uuid" },
                      "dueAt": { "type": ["string", "null"], "format": "date-time" },
                      "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
                      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                      "sourceMessageIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } }
                    }
                  }
                },
                "keyFacts": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["category", "content", "confidence", "sourceMessageIds"],
                    "properties": {
                      "category": { "type": "string", "minLength": 1, "maxLength": 80 },
                      "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
                      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                      "sourceMessageIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } }
                    }
                  }
                }
              }
            },
            { "type": "null" }
          ]
        },
        "syncSeq": { "type": "integer", "minimum": 1 }
      }
    },
    "aiDeletionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "conversationId", "syncSeq"],
      "properties": {
        "entityId": { "type": "string", "format": "uuid" },
        "conversationId": { "type": "string", "format": "uuid" },
        "syncSeq": { "type": "integer", "minimum": 1 }
      }
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
