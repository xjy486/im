{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jitong.invalid/contracts/error-response-v1.schema.json",
  "title": "Jitong API Error Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "code", "message", "requestId", "timestamp"],
  "properties": {
    "version": {
      "const": 1
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
