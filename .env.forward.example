# Local SSH-forwarded dependencies for cloud integration.
# Copy this file to .env.forward and replace the placeholder values locally.
# Never commit the copied file or paste its contents into chat/issues.
JITONG_HTTP_PORT=8080
SERVER_PORT=8080

DB_URL=jdbc:postgresql://127.0.0.1:5432/appdb
DB_USERNAME=postgres
DB_PASSWORD=replace-with-forwarded-postgresql-password

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-forwarded-minio-access-key
MINIO_SECRET_KEY=replace-with-forwarded-minio-secret-key
MINIO_BUCKET=jitong-media

# Required by /api/v1/admin/users. Generate a local-only value.
ADMIN_API_KEY=replace-with-local-admin-api-key

# Optional real AI provider configuration. Keep disabled unless the forwarded
# environment is intentionally used for synthetic AI testing.
AI_PROVIDER_ENABLED=false
AI_PROVIDER_SUPPORTS_VISION=false
AI_IMAGE_INPUT_ENABLED=false
