# Copy this file to .env for a local or single-node deployment.
# Every value below is an example only. Generate fresh values before use.

JITONG_HTTP_PORT=8080
COMPOSE_PROJECT_NAME=jitong-im

POSTGRES_PASSWORD=replace-with-a-random-postgres-password
MINIO_ROOT_USER=jitong
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
MINIO_BUCKET=jitong-media
ADMIN_API_KEY=replace-with-a-random-admin-api-key

# Production Caddy settings. They are only required with
# compose.production.yaml.
JITONG_DOMAIN=im.example.com
CADDY_EMAIL=ops@example.com

# The server image can be supplied by a release bundle. Leave the default
# alone when Compose should build the image from the checked-out source.
JITONG_SERVER_IMAGE=jitong-im-server:local

# FCM and AI are disabled by default. Never put real credentials in a
# committed environment template.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_TOKEN_ENCRYPTION_KEY=
AI_PROVIDER_ENABLED=false
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini
AI_PROVIDER_REQUEST_TIMEOUT=90s
AI_PROVIDER_SUPPORTS_VISION=false
AI_IMAGE_INPUT_ENABLED=false
AI_WORKER_POLL_INTERVAL=250
AI_WORKER_LEASE_TIMEOUT=2m
AI_DAILY_TOKEN_LIMIT=100000
AI_MAX_OUTPUT_TOKENS=8192
AI_RETENTION_INTERVAL=60000
AI_RETENTION_INITIAL_DELAY=60000
