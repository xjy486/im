<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="jitong_secure_state.xml" />
        <exclude domain="sharedpref" path="jitong_device_identity.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="account-media" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jitong_secure_state.xml" />
        <exclude domain="sharedpref" path="jitong_device_identity.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="account-media" />
    </device-transfer>
</data-extraction-rules>
